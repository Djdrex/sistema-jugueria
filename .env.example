PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/jugueria_dev
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Comma-separated allowed origins for separate frontend hosts; same-origin hosting needs none.
CORS_ORIGINS=
# Set to 1 only when the service is behind one trusted reverse proxy (such as Render).
TRUST_PROXY_HOPS=0
# Only needed for the explicit initial-admin bootstrap command; remove after use.
ADMIN_BOOTSTRAP_PASSWORD=
